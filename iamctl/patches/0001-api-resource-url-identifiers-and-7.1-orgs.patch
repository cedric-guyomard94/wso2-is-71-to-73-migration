+// Les identifiants d'API resources sont souvent des URLs (https://api.x/y) :
+// le "/" est encodé en "%2F" dans le nom de fichier (même convention que pour les rôles).
+func identifierToFileName(identifier string) string {
+
+	return strings.ReplaceAll(identifier, "/", "%2F")
+}
+
+func fileNameToIdentifier(fileName string) string {
+
+	return strings.ReplaceAll(fileName, "%2F", "/")
+}
